#!/bin/bash

export REPO_ROOT="$(pwd)"
export TIMESTAMP="$(date '+%Y%m%dT%H%M%SZ')"
export TREEISH="latest.xz"
export CATALYST_CONF="${REPO_ROOT}"/etc/catalyst/default/catalyst.conf
export CATALYST_LOG="${REPO_ROOT}"/var/tmp/catalyst/logs/23.0-enomem/stage3-armv6j-rapi-zerow-openrc-"${TIMESTAMP}".bootstrap.log
export PORTAGE_CONFDIR="${REPO_ROOT}"/etc/portage/23-enomem/arm/armv6j/stage3.bootstrap
