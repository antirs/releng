#!/bin/bash

export REPO_ROOT="$(pwd)"
export TIMESTAMP="$(date '+%Y%m%dT%H%M%SZ')"
export TREEISH="latest.xz"
export CATALYST_CONF="${REPO_ROOT}"/etc/catalyst/default/catalyst.conf
export CATALYST_LOG="${REPO_ROOT}"/var/tmp/catalyst/logs/23.0-enomem/stage1-armv6j-openrc-"${TIMESTAMP}".bootstrap.log
export PORTAGE_CONFDIR="${REPO_ROOT}"/etc/portage/23-enomem/arm/stage1.bootstrap
