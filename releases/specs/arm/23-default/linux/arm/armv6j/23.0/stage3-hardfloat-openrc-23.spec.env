#!/bin/bash

export REPO_ROOT="$(pwd)"
export TREEISH="latest.xz"
export CATALYST_CONF_TEMPLATE="${REPO_ROOT}"/etc/catalyst/default/catalyst-distcc.conf.template
export CATALYST_STOREDIR="${REPO_ROOT}"/"var/tmp/catalyst"
export CATALYST_CONF_DIR="${CATALYST_STOREDIR}"/confs/23.0-default/stage3-armv6j_hardfp-openrc-"${TIMESTAMP}"
export CATALYST_LOG="${CATALYST_STOREDIR}"/logs/23.0-default/stage3-armv6j_hardfp-openrc-"${TIMESTAMP}".log
export PORTAGE_CONFDIR="${REPO_ROOT}"/etc/portage/23-default/arm/armv6j/hf/stage3
export PKGCACHE_PATH="${REPO_ROOT}"/var/tmp/catalyst/packages/arm/binpackages/23.0-default/armv6j/stage3-armv6j_hardfp
export MAKEOPTS="-j16"
export DISTCC_HOSTS="10.10.10.10:3632/8 10.10.10.11:3632/4 --randomize --localslots=4 --localslots_cpp=12"
export GENTOOBINHOST="http://10.10.10.10:8080/releases/arm/binpackages/23.0-default/armv6j/stage3-armv6j_hardfp"
export EMERGE_DEFAULT_OPTS="--getbinpkg y --usepkg-exclude sys-apps/baselayout --buildpkg-exclude sys-apps/baselayout"
