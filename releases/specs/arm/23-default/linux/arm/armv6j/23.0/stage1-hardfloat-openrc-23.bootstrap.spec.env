#!/bin/bash

export REPO_ROOT="$(pwd)"
export TIMESTAMP="$(date '+%Y%m%dT%H%M%SZ')"
export TREEISH="latest.xz"
export CATALYST_CONF_TEMPLATE="${REPO_ROOT}"/etc/catalyst/default/catalyst-distcc.conf.template
export CATALYST_STOREDIR="${REPO_ROOT}"/"var/tmp/catalyst"
export CATALYST_CONF_DIR="${CATALYST_STOREDIR}"/confs/23.0-default/stage1-armv6j_hardfp-openrc-"${TIMESTAMP}".bootstrap
export CATALYST_LOG="${CATALYST_STOREDIR}"/logs/23.0-default/stage1-armv6j_hardfp-openrc-"${TIMESTAMP}".bootstrap.log
export PORTAGE_CONFDIR="${REPO_ROOT}"/etc/portage/23-default/arm/armv6j/hf/stage1.bootstrap
export MAKEOPTS="-j8"
export DISTCC_HOSTS="10.10.10.10:3632 10.10.10.11:3632"
