#!/bin/bash

export REPO_ROOT="$(pwd)"
export TIMESTAMP="$(date '+%Y%m%dT%H%M%SZ')"
export TREEISH="latest.xz"
export CATALYST_CONF="${REPO_ROOT}"/etc/catalyst/default/catalyst-distcc.conf
export CATALYST_LOG="${REPO_ROOT}"/var/tmp/catalyst/logs/23.0-default/stage3-armv6j-openrc-"${TIMESTAMP}".bootstrap.log
export PORTAGE_CONFDIR="${REPO_ROOT}"/etc/portage/23-default/arm/armv6j/sf/stage3.bootstrap
