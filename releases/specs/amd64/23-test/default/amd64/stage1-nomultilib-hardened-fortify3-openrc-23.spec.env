#!/bin/bash

export REPO_ROOT="$(pwd)"
export TIMESTAMP="$(date '+%Y%m%dT%H%M%SZ')"
export TREEISH="latest.xz"
export CATALYST_CONF_TEMPLATE="${REPO_ROOT}"/etc/catalyst/default/catalyst-distcc.conf.template
export CATALYST_STOREDIR="${REPO_ROOT}"/"var/tmp/catalyst"
export CATALYST_CONF_DIR="${CATALYST_STOREDIR}"/confs/23.0-test/stage1-amd64-nomultilib-hardened-fortify3-openrc-${TIMESTAMP}
export CATALYST_LOG="${CATALYST_STOREDIR}"/logs/23.0-test/stage1-amd64-nomultilib-hardened-fortify3-openrc-${TIMESTAMP}.log
export PORTAGE_CONFDIR="${REPO_ROOT}"/etc/portage/23-test/stage1
export MAKEOPTS="-j16"
export DISTCC_HOSTS="10.10.10.10:3632/8 10.10.10.11:3632/4 --randomize --localslots=4 --localslots_cpp=4"
