subarch: amd64
target: stage1
version_stamp: hardened-static-openrc-${TIMESTAMP}
rel_type: 23.0-enomem
repos: ${REPO_ROOT}/etc/portage/default/overlays/enomem
profile: enomem:default/amd64/hardened/static/stage1
snapshot_treeish: ${TREEISH}
source_subpath: 23.0-enomem/stage3-amd64-hardened-static-openrc-latest.bootstrap.tar.xz
compression_mode: pixz
#update_seed: no
update_seed: yes
#update_seed_command: --update --deep --newuse --emptytree --complete-graph y --with-bdeps y @world
update_seed_command: --update --deep --newuse --complete-graph y --with-bdeps y --usepkg --getbinpkg --buildpkg n --binpkg-respect-use=y @world
portage_confdir: ${PORTAGE_CONFDIR}
portage_prefix: releng
pkgcache_path: ${PKGCACHE_PATH}
