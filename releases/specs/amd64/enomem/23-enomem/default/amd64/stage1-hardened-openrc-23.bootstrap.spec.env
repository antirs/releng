#!/bin/bash

export REPO_ROOT="$(pwd)"
export TREEISH="latest.xz"
export CATALYST_VERSION_STAMP="hardened-openrc-${TIMESTAMP}.bootstrap"
export CATALYST_CONF_TEMPLATE="${REPO_ROOT}"/etc/catalyst/default/catalyst-distcc.conf.template
export CATALYST_STOREDIR="${REPO_ROOT}"/"var/tmp/catalyst"
export CATALYST_CONF_DIR="${CATALYST_STOREDIR}"/confs/23.0-enomem/stage1-amd64-"${CATALYST_VERSION_STAMP}"
export CATALYST_SHDIR="${REPO_ROOT}"/share/catalyst/default/targets
export CATALYST_LOG="${CATALYST_STOREDIR}"/logs/23.0-enomem/stage1-amd64-"${CATALYST_VERSION_STAMP}".log
export CATALYST_PROFILE="enomem:default/amd64/hardened/stage1"
export CATALYST_SOURCE="23.0-default/stage3-amd64-openrc-latest.tar.xz"
export CATALYST_UPDATE_SEED_COMMAND="--update --deep --newuse --emptytree --complete-graph y --with-bdeps y --usepkg --getbinpkg --buildpkg n --binpkg-respect-use=y @world"
export PORTAGE_CONFDIR="${REPO_ROOT}"/etc/portage/23-enomem/amd64/stage1.bootstrap
export PKGCACHE_PATH="${REPO_ROOT}"/var/tmp/catalyst/packages/amd64/binpackages/23.0-enomem/stage1-amd64-hardened
export MAKEOPTS="-j16"
export DISTCC_HOSTS="10.10.10.10:3632/8 10.10.10.11:3632/4 --randomize --localslots=4 --localslots_cpp=12"
export GENTOOBINHOST="http://172.17.0.1:8080/releases/amd64/binpackages/23.0-enomem/stage1-amd64-hardened"
export EMERGE_DEFAULT_OPTS="--getbinpkg y --usepkg-exclude sys-apps/baselayout --buildpkg-exclude sys-apps/baselayout"
export BINPKG_GPG_SIGNING_GPG_HOME='/etc/portage/gnupg/releng/gnupg'
export BINPKG_GPG_SIGNING_KEY='0xF5C62A27BE1D3DAEC417CF79CE48952C411666D9'
