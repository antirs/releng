#!/bin/bash

export REPO_ROOT="$(pwd)"
export TREEISH="latest.xz"
export CATALYST_VERSION_STAMP="t440p-nomultilib-hardened-static-openrc-${TIMESTAMP}"
export CATALYST_CONF_TEMPLATE="${REPO_ROOT}"/etc/catalyst/default/catalyst-distcc.conf.template
export CATALYST_STOREDIR="${REPO_ROOT}"/"var/tmp/catalyst"
export CATALYST_CONF_DIR="${CATALYST_STOREDIR}"/confs/23.0-enomem/stage3-amd64-"${CATALYST_VERSION_STAMP}"
export CATALYST_LOG="${CATALYST_STOREDIR}"/logs/23.0-enomem/stage3-amd64-"${CATALYST_VERSION_STAMP}".log
export CATALYST_PROFILE="enomem:devices/notebook/amd64/lenovo/thinkpad/t440p/no-multilib/hardened/static/stage3"
export CATALYST_SOURCE="23.0-enomem/stage1-amd64-t440p-nomultilib-hardened-static-openrc-latest.tar.xz"
export PORTAGE_CONFDIR="${REPO_ROOT}"/etc/portage/23-enomem/amd64/stage3
export PKGCACHE_PATH="${REPO_ROOT}"/var/tmp/catalyst/packages/amd64/binpackages/23.0-enomem/notebook/lenovo/thinkpad/t440p/stage3-amd64-t440p-nomultilib-hardened-static
export MAKEOPTS="-j16"
export DISTCC_HOSTS="10.10.10.10:3632/8 10.10.10.11:3632/4 --randomize --localslots=4 --localslots_cpp=12"
export GENTOOBINHOST="http://172.17.0.1:8080/releases/amd64/binpackages/23.0-enomem/notebook/lenovo/thinkpad/t440p/stage3-amd64-t440p-nomultilib-hardened-static"
export EMERGE_DEFAULT_OPTS="--getbinpkg y --usepkg-exclude sys-apps/baselayout --buildpkg-exclude sys-apps/baselayout"
export BINPKG_GPG_SIGNING_GPG_HOME='/etc/portage/gnupg/releng/gnupg'
export BINPKG_GPG_SIGNING_KEY='0xF5C62A27BE1D3DAEC417CF79CE48952C411666D9'
