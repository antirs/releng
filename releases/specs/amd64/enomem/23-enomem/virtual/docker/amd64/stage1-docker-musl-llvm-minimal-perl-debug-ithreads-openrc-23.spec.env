#!/bin/bash

export REPO_ROOT="$(pwd)"
export TREEISH="latest.xz"
export CATALYST_VERSION_STAMP="docker-minimal-musl-llvm-perl-debug-ithreads-openrc"-${TIMESTAMP}
export CATALYST_CONF_TEMPLATE="${REPO_ROOT}"/etc/catalyst/default/catalyst.conf.template
export CATALYST_STOREDIR="${REPO_ROOT}"/"var/tmp/catalyst"
export CATALYST_CONF_DIR="${CATALYST_STOREDIR}"/confs/23.0-enomem/stage1-amd64-${CATALYST_VERSION_STAMP}
export CATALYST_SHDIR="${REPO_ROOT}"/share/catalyst/virtual/docker/minimal/targets
export CATALYST_LOG="${CATALYST_STOREDIR}"/logs/23.0-enomem/stage1-amd64-${CATALYST_VERSION_STAMP}.log
export CATALYST_REPOS="
	${REPO_ROOT}/etc/portage/default/overlays/enomem"
export CATALYST_PROFILE="enomem:virtual/docker/amd64/musl/llvm/minimal/perl/debug/ithreads"
export CATALYST_SOURCE="23.0-enomem/stage3-amd64-musl-llvm-20-hardened-openrc-latest.tar.xz"
export CATALYST_UPDATE_SEED_COMMAND="--deep --update --newuse --complete-graph y --with-bdeps y --ignore-world y --usepkg --getbinpkg --buildpkg n --binpkg-respect-use y dev-lang/perl"
export CATALYST_UPDATE_SEED="yes"
export PORTAGE_CONFDIR_SOURCE="${REPO_ROOT}"/etc/portage/23-enomem/amd64-musl-llvm/stage1
export PORTAGE_ENVS="
${REPO_ROOT}/etc/portage/default/overlays/enomem/profiles/mixins/base/portage/envs/utils/catalyst/stage1/bootstrap/package.env
${REPO_ROOT}/etc/portage/default/overlays/enomem/profiles/mixins/base/portage/envs/utils/catalyst/stage1/multilib/package.env
${REPO_ROOT}/etc/portage/default/overlays/enomem/profiles/mixins/base/portage/envs/features/distcc/package.env
${REPO_ROOT}/etc/portage/default/overlays/enomem/profiles/mixins/base/portage/envs/features/binpkg/signing/package.env
${REPO_ROOT}/etc/portage/default/overlays/enomem/profiles/mixins/base/portage/envs/flags/base/symbols/version/package.env
${REPO_ROOT}/etc/portage/default/overlays/enomem/profiles/mixins/base/portage/envs/issues/distcc/no/package.env
${REPO_ROOT}/etc/portage/default/overlays/enomem/profiles/mixins/base/portage/envs/issues/diagnostics/pedantic/package.env
${REPO_ROOT}/etc/portage/default/overlays/enomem/profiles/mixins/base/portage/envs/issues/tmpfs/no/package.env
${REPO_ROOT}/etc/portage/default/overlays/enomem/profiles/mixins/base/portage/envs/issues/musl/llvm/libcxx/optimizer/package.env
${REPO_ROOT}/etc/portage/default/overlays/enomem/profiles/mixins/base/portage/envs/issues/gentoo/limited/memory/16g/package.env
${REPO_ROOT}/etc/portage/default/overlays/enomem/profiles/mixins/base/portage/envs/issues/gentoo/lto/no/package.env"
export PORTAGE_KEYWORDS="
${REPO_ROOT}/etc/portage/default/overlays/enomem/profiles/mixins/linux/amd64/portage/keywords/stage1/bootstrap/package.accept_keywords"
export PORTAGE_LICENSES="
${REPO_ROOT}/etc/portage/default/overlays/enomem/profiles/mixins/base/portage/licenses/linux-firmware/package.license"
export PORTAGE_MASKS="
${REPO_ROOT}/etc/portage/default/overlays/enomem/profiles/mixins/base/portage/sets/stage1/bootstrap/package.mask
${REPO_ROOT}/etc/portage/default/overlays/enomem/profiles/mixins/base/portage/sets/versions/llvm/20/package.mask"
export PKGCACHE_PATH="${REPO_ROOT}"/var/tmp/catalyst/packages/amd64/binpackages/23.0-enomem/virtual/docker/stage1-amd64-docker-minimal-musl-llvm
export MAKEOPTS="-j16"
export DISTCC_HOSTS="10.10.10.10:3632/8 10.10.10.11:3632/4 --randomize --localslots=4 --localslots_cpp=12"
export GENTOOBINHOST="http://10.10.10.10:8080/releases/amd64/binpackages/23.0-enomem/virtual/docker/stage1-amd64-docker-minimal-musl-llvm"
export EMERGE_DEFAULT_OPTS="--getbinpkg y --usepkg-exclude sys-apps/baselayout --buildpkg-exclude sys-apps/baselayout --with-bdeps n"
export BINPKG_GPG_SIGNING_GPG_HOME="/etc/portage/gnupg/releng/gnupg"
export BINPKG_GPG_SIGNING_KEY="0xF5C62A27BE1D3DAEC417CF79CE48952C411666D9"

export EN_CATALYST_SYSROOT=""
export EN_CATALYST_UPDATE_SYSROOT="no"
export EN_CATALYST_UPDATE_SYSROOT_COMMANDS=""
export EN_CATALYST_BROOT="/tmp/stage1broot"
export EN_CATALYST_PROFILE_BROOT="enomem:default/amd64/musl/llvm/hardened/stage3"
export EN_CATALYST_UPDATE_BROOT="yes"
export EN_CATALYST_UPDATE_BROOT_COMMANDS="
--update --newuse --complete-graph y --with-bdeps y --ignore-world y --usepkg --getbinpkg --buildpkg n --binpkg-respect-use y sys-kernel/linux-headers
--update --newuse --complete-graph y --with-bdeps y --ignore-world y --usepkg --getbinpkg --buildpkg n --binpkg-respect-use y dev-lang/perl
"
