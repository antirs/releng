export CATALYST_UPDATE_SEED_COMMAND="--deep --complete-graph y --with-bdeps y --usepkg --getbinpkg --buildpkg y --binpkg-respect-use=y --oneshot --nodeps sec-keys/openpgp-keys-vincentlefevre sys-devel/gcc-config dev-libs/gmp dev-libs/isl dev-libs/mpfr dev-libs/mpc sys-devel/gcc llvm-core/clang-common llvm-core/llvm llvm-core/clang llvm-core/lld llvm-runtimes/compiler-rt llvm-runtimes/compiler-rt-sanitizers llvm-runtimes/libcxxabi llvm-runtimes/libcxx"
export CATALYST_UPDATE_SEED="yes"
export PORTAGE_CONFDIR_SOURCE="${REPO_ROOT}"/etc/portage/23-enomem/amd64-musl-llvm/stage1.bootstrap
export PORTAGE_ENVS="
${REPO_ROOT}/etc/portage/default/overlays/enomem/profiles/mixins/base/portage/envs/utils/catalyst/stage1/bootstrap/package.env
${REPO_ROOT}/etc/portage/default/overlays/enomem/profiles/mixins/base/portage/envs/utils/catalyst/stage1/multilib/package.env
