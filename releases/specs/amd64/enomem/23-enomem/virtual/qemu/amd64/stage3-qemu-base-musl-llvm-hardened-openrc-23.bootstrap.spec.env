#!/bin/bash

export REPO_ROOT="$(pwd)"
export TREEISH="latest.xz"
export CATALYST_VERSION_STAMP="qemu-base-musl-llvm-hardened-openrc-20-${TIMESTAMP}.bootstrap"
export CATALYST_CONF_TEMPLATE="${REPO_ROOT}"/etc/catalyst/default/catalyst.conf.template
export CATALYST_STOREDIR="${REPO_ROOT}"/"var/tmp/catalyst"
export CATALYST_CONF_DIR="${CATALYST_STOREDIR}"/confs/23.0-enomem/stage3-amd64-"${CATALYST_VERSION_STAMP}"
export CATALYST_LOG="${CATALYST_STOREDIR}"/logs/23.0-enomem/stage3-amd64-"${CATALYST_VERSION_STAMP}".log
export CATALYST_PROFILE="enomem:virtual/qemu/amd64/base/musl/llvm/hardened/stage3/bootstrap"
export CATALYST_SOURCE="23.0-enomem/stage1-amd64-qemu-base-musl-llvm-hardened-openrc-20-latest.bootstrap.tar.xz"
export PORTAGE_CONFDIR_SOURCE="${REPO_ROOT}"/etc/portage/23-enomem/amd64-musl-llvm/stage3.bootstrap
export PORTAGE_ENVS="
${REPO_ROOT}/etc/portage/default/overlays/enomem/profiles/mixins/base/portage/envs/utils/catalyst/stage1/bootstrap/package.env
${REPO_ROOT}/etc/portage/default/overlays/enomem/profiles/mixins/base/portage/envs/utils/catalyst/stage1/multilib/package.env
${REPO_ROOT}/etc/portage/default/overlays/enomem/profiles/mixins/base/portage/envs/features/distcc/package.env
${REPO_ROOT}/etc/portage/default/overlays/enomem/profiles/mixins/base/portage/envs/features/binpkg/signing/package.env
${REPO_ROOT}/etc/portage/default/overlays/enomem/profiles/mixins/base/portage/envs/flags/base/symbols/version/package.env
${REPO_ROOT}/etc/portage/default/overlays/enomem/profiles/mixins/base/portage/envs/utils/catalyst/stage3/bootstrap/musl/llvm/package.env"
export PORTAGE_KEYWORDS="
${REPO_ROOT}/etc/portage/default/overlays/enomem/profiles/mixins/linux/amd64/portage/keywords/stage1/bootstrap/package.accept_keywords"
export PORTAGE_LICENSES="
${REPO_ROOT}/etc/portage/default/overlays/enomem/profiles/mixins/base/portage/licenses/linux-firmware/package.license"
export PORTAGE_MASKS="
${REPO_ROOT}/etc/portage/default/overlays/enomem/profiles/mixins/base/portage/sets/stage1/bootstrap/package.mask
${REPO_ROOT}/etc/portage/default/overlays/enomem/profiles/mixins/base/portage/sets/versions/llvm/20/package.mask"
export PKGCACHE_PATH="${REPO_ROOT}"/var/tmp/catalyst/packages/amd64/binpackages/23.0-enomem/virtual/qemu/stage3-amd64-qemu-base-musl-llvm-hardened.bootstrap
export MAKEOPTS="-j8"
export DISTCC_HOSTS="10.10.10.10:3632/8 10.10.10.11:3632/4 --randomize --localslots=4 --localslots_cpp=12"
export GENTOOBINHOST="http://172.17.0.1:8080/releases/amd64/binpackages/23.0-enomem/virtual/qemu/stage3-amd64-qemu-base-musl-llvm-hardened.bootstrap"
export EMERGE_DEFAULT_OPTS="--getbinpkg y --usepkg-exclude sys-apps/baselayout --buildpkg-exclude sys-apps/baselayout"
export BINPKG_GPG_SIGNING_GPG_HOME="/etc/portage/gnupg/releng/gnupg"
export BINPKG_GPG_SIGNING_KEY="0xF5C62A27BE1D3DAEC417CF79CE48952C411666D9"
