#!/bin/bash

export REPO_ROOT="$(pwd)"
export TREEISH="latest.xz"
export CATALYST_CONF_TEMPLATE="${REPO_ROOT}"/etc/catalyst/default/catalyst-distcc.conf.template
export CATALYST_STOREDIR="${REPO_ROOT}"/"var/tmp/catalyst"
export CATALYST_CONF_DIR="${CATALYST_STOREDIR}"/confs/23.0-enomem/stage1-amd64-t440p-nomultilib-openrc-${TIMESTAMP}.bootstrap
export CATALYST_SHDIR="${REPO_ROOT}"/share/catalyst/default/targets
export CATALYST_LOG="${CATALYST_STOREDIR}"/logs/23.0-enomem/stage1-amd64-t440p-nomultilib-openrc-${TIMESTAMP}.bootstrap.log
export PORTAGE_CONFDIR="${REPO_ROOT}"/etc/portage/23-enomem/stage1
export PKGCACHE_PATH="${REPO_ROOT}"/var/tmp/catalyst/packages/amd64/binpackages/23.0-enomem/notebook/lenovo/thinkpad/t440p/stage1-amd64-t440p-nomultilib
export MAKEOPTS="-j16"
export DISTCC_HOSTS="10.10.10.10:3632/8 10.10.10.11:3632/4 --randomize --localslots=4 --localslots_cpp=12"
export GENTOOBINHOST="http://172.17.0.1:8080/releases/amd64/binpackages/23.0-enomem/notebook/lenovo/thinkpad/t440p/stage1-amd64-t440p-nomultilib"
export EMERGE_DEFAULT_OPTS="--getbinpkg y --usepkg-exclude sys-apps/baselayout --buildpkg-exclude sys-apps/baselayout"
