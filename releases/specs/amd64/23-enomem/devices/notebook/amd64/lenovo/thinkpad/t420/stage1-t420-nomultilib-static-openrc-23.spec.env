#!/bin/bash

export REPO_ROOT="$(pwd)"
export TIMESTAMP="$(date '+%Y%m%dT%H%M%SZ')"
export TREEISH="latest.xz"
export CATALYST_CONF="${REPO_ROOT}"/etc/catalyst/default/catalyst.conf
export CATALYST_LOG="${REPO_ROOT}"/var/tmp/catalyst/logs/23.0-enomem/stage1-amd64-t420-nomultilib-static-openrc-${TIMESTAMP}.log
export PORTAGE_CONFDIR="${REPO_ROOT}"/etc/portage/23-enomem/stage1
