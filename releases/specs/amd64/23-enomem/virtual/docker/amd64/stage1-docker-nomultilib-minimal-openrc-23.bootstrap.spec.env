#!/bin/bash

export REPO_ROOT="$(pwd)"
export TIMESTAMP="$(date '+%Y%m%dT%H%M%SZ')"
export TREEISH="latest.xz"
export CATALYST_CONF="${REPO_ROOT}"/etc/catalyst/virtual/docker/minimal/catalyst.conf
export CATALYST_LOG="${REPO_ROOT}"/var/tmp/catalyst/logs/23.0-enomem/stage1-amd64-docker-nomultilib-minimal-openrc-${TIMESTAMP}.bootstrap.log
