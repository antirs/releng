${REPO_ROOT}/etc/portage/default/overlays/enomem/profiles/mixins/base/portage/uses/stage1/bootstrap/package.use
${REPO_ROOT}/etc/portage/default/overlays/enomem/profiles/mixins/base/portage/uses/useexpands/package.use
${REPO_ROOT}/etc/portage/default/overlays/enomem/profiles/mixins/base/portage/uses/useexpands/enomem/o2/package.use
${REPO_ROOT}/etc/portage/default/overlays/enomem/profiles/mixins/linux/riscv/portage/uses/useexpands/enomem/riscv/package.use
${REPO_ROOT}/etc/portage/default/overlays/enomem/profiles/mixins/linux/riscv/portage/uses/useexpands/enomem/riscv/rv64/package.use
${REPO_ROOT}/etc/portage/default/overlays/enomem/profiles/mixins/linux/riscv/portage/uses/useexpands/enomem/riscv/rv64/lp64d/package.use
${REPO_ROOT}/etc/portage/default/overlays/enomem/profiles/mixins/base/portage/uses/useexpands/no_grub/package.use
${REPO_ROOT}/etc/portage/default/overlays/enomem/profiles/mixins/base/portage/uses/no_cpudetection/package.use
${REPO_ROOT}/etc/portage/default/overlays/enomem/profiles/mixins/base/portage/uses/no_asm/package.use"
export PORTAGE_PROFILE_MAKES="
${REPO_ROOT}/etc/portage/default/overlays/enomem/profiles/mixins/base/portage/confs/base/make.defaults
${REPO_ROOT}/etc/portage/default/overlays/enomem/profiles/mixins/linux/riscv/portage/confs/rv64/lp64d/base/make.defaults
${REPO_ROOT}/etc/portage/default/overlays/enomem/profiles/mixins/linux/riscv/portage/confs/rv64/lp64d/base/compile/make.defaults
${REPO_ROOT}/etc/portage/default/overlays/enomem/profiles/mixins/base/portage/confs/base/compile/make.defaults"
