${REPO_ROOT}/etc/portage/default/overlays/enomem/profiles/mixins/base/portage/uses/base/use.mask
${REPO_ROOT}/etc/portage/default/overlays/enomem/profiles/mixins/base/portage/uses/no_cpudetection/use.mask
${REPO_ROOT}/etc/portage/default/overlays/enomem/profiles/mixins/base/portage/uses/no_asm/use.mask"
export PKGCACHE_PATH="${REPO_ROOT}"/var/tmp/catalyst/packages/riscv/binpackages/23.0-default/rv64/lp64d/stage1-rv64_lp64d.bootstrap
export MAKEOPTS="-j16"
export DISTCC_HOSTS="10.10.10.10:3632/8 10.10.10.11:3632/4 --randomize --localslots=4 --localslots_cpp=12"
export GENTOOBINHOST="http://10.10.10.10:8080/releases/riscv/binpackages/23.0-default/rv64/lp64d/stage1-rv64_lp64d.bootstrap"
