From b7365b9311d9e1b030378e263385eda6957f3f64 Mon Sep 17 00:00:00 2001
From: CMCOliver <oheesakkers@conclusion.nl>
Date: Tue, 24 Jan 2017 16:27:18 +0100
Subject: [PATCH] Use nullptr instead of comparing to 0

---
 bushnell.cc | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/bushnell.cc b/bushnell.cc
index f4cad0b26..f44b7fde7 100644
--- a/bushnell.cc
+++ b/bushnell.cc
@@ -136,7 +136,7 @@ bushnell_get_icon_from_name(QString name)
     name = "Waypoint";
   }
 
-  for (t = bushnell_icons; t->icon > 0; t++) {
+  for (t = bushnell_icons; t->icon != nullptr; t++) {
     if (0 == name.compare(t->icon, Qt::CaseInsensitive)) {
       return t->symbol;
     }
@@ -148,7 +148,7 @@ static const char*
 bushnell_get_name_from_symbol(signed int s)
 {
   icon_mapping_t* t;
-  for (t = bushnell_icons; t->icon > 0; t++) {
+  for (t = bushnell_icons; t->icon != nullptr; t++) {
     if (s == t->symbol) {
       return t->icon;
     }
